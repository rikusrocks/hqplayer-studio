{
  "id": "/remote/",
  "name": "HQPlayer Studio Remote",
  "short_name": "Studio Remote",
  "description": "Web remote for HQPlayer Studio. Audio always plays from HQPlayer on the host PC — never in the browser.",
  "lang": "zh-CN",
  "start_url": "/remote/",
  "scope": "/remote/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0d0e11",
  "theme_color": "#0d0e11",
  "icons": [
    {
      "src": "/remote/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/remote/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/remote/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/remote/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/remote/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
