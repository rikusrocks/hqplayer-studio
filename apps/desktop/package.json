{
  "name": "@hqps/desktop",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "productName": "HQPlayer Studio",
  "description": "HQPlayer Studio Desktop (third-party client for HQPlayer Desktop 6, not affiliated with Signalyst).",
  "author": "HQPlayer Studio contributors",
  "license": "MIT",
  "main": "dist/main/main.mjs",
  "scripts": {
    "dev:web": "vite --config vite.config.ts",
    "dev:electron": "pnpm --filter @hqps/remote build && pnpm run build && electron .",
    "build": "pnpm build:renderer && pnpm build:main && node scripts/copy-remote.mjs",
    "build:renderer": "vite build --config vite.config.ts",
    "build:main": "node scripts/build-main.mjs",
    "package:win": "electron-builder --win portable zip --x64 --publish never",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@hqps/api-client": "workspace:*",
    "@hqps/contracts": "workspace:*",
    "@hqps/core": "workspace:*",
    "@hqps/hqplayer-adapter": "workspace:*",
    "@hqps/library": "workspace:*",
    "@hqps/ui": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.7"
  }
}
